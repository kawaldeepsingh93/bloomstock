{
  "name": "@bloomstock/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --config ../../jest.config.base.cjs --rootDir .",
    "migrate": "echo 'Apply supabase/migrations via supabase db push or the SQL editor'"
  },
  "dependencies": {
    "@bloomstock/core": "workspace:*",
    "@bloomstock/shared": "workspace:*",
    "@supabase/supabase-js": "^2.49.1"
  }
}
