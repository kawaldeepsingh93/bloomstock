# App
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# OpenAI — never expose to the browser
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5
OPENAI_MAX_RECOMMENDATIONS=3

# Zerodha Kite Connect — never expose to the browser
KITE_API_KEY=your-kite-api-key
KITE_API_SECRET=your-kite-api-secret
KITE_ACCESS_TOKEN=your-kite-access-token

# Alpha Vantage — never expose to the browser
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# Redis
REDIS_URL=redis://localhost:6379

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM=
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@bloomstock.app

# Risk defaults
DEFAULT_CAPITAL=100000
DEFAULT_RISK_PERCENT=1

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
