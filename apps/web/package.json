{
  "name": "@bloomstock/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../../.env ./node_modules/next/dist/bin/next dev --hostname 0.0.0.0 --port 3000",
    "build": "node --env-file=../../.env ./node_modules/next/dist/bin/next build",
    "start": "node --env-file=../../.env ./node_modules/next/dist/bin/next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest --config ../../jest.config.base.cjs --rootDir . --testPathPattern=src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bloomstock/ai": "workspace:*",
    "@bloomstock/core": "workspace:*",
    "@bloomstock/database": "workspace:*",
    "@bloomstock/market-data": "workspace:*",
    "@bloomstock/notifications": "workspace:*",
    "@bloomstock/shared": "workspace:*",
    "@bloomstock/trading": "workspace:*",
    "@bloomstock/ui": "workspace:*",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-table": "^8.21.2",
    "lucide-react": "^0.483.0",
    "ioredis": "^5.6.0",
    "next": "^15.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  }
}
